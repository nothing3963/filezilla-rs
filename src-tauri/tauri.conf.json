{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileZilla Modern",
  "version": "0.1.1",
  "identifier": "org.filezilla.modern",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec tsc --noEmit && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileZilla Modern",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
